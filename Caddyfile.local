# Floatline - LOCAL Docker testing (plain HTTP, no ACME)
#
# Purpose: exercise the real container topology (Caddy -> static Astro build +
#          FastAPI) on your machine, WITHOUT touching Let's Encrypt.
#
# Why a separate file instead of the production Caddyfile:
#   * The production site address is `floatline.biz` with `auto_https on`. Run
#     locally, Caddy would attempt a REAL ACME challenge for a domain you do not
#     control. That fails, and repeated failures can burn Let's Encrypt's
#     failed-validation rate limit (5 per hostname/hour) - which would then also
#     block your actual VPS deploy. So: localhost + plain HTTP here.
#
# Usage:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
#   seed:  docker compose -f docker-compose.yml -f docker-compose.local.yml \
#            exec fastapi_web python -m app.scripts.seed_history
#   open:  http://localhost:8080
#
# The directives mirror the production Caddyfile exactly (same handle blocks,
# same upstreams) so the proxy behaviour is a faithful test.

{
	auto_https off
	admin off
}

http://localhost:8080 {
	encode gzip

	log {
		output stdout
		format json
	}

	# --- REST API ----------------------------------------------------------
	handle /api/* {
		reverse_proxy fastapi_web:8000
	}

	# --- FastAPI docs ------------------------------------------------------
	handle /docs* {
		reverse_proxy fastapi_web:8000
	}
	handle /redoc* {
		reverse_proxy fastapi_web:8000
	}
	handle /openapi.json {
		reverse_proxy fastapi_web:8000
	}

	# --- Health probe ------------------------------------------------------
	handle /health {
		rewrite * /api/health
		reverse_proxy fastapi_web:8000
	}

	# --- Static Astro dashboard with SPA fallback --------------------------
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}