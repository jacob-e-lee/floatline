# ==========================================
# Floatline Environment Variables (template)
# ==========================================

# 1. Capital One Nessie (test) API  ->  https://api.nessieisreal.com
# Get your key from developer.capitalone.com (Nessie / Retrieve API Key).
# The sandbox serves HTTPS (:443); HTTP (:80) is refused. Override below if needed.
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=
NESSIE_CHECKING_ACCOUNT_ID=
NESSIE_SAVINGS_ACCOUNT_ID=

# 2. Alpaca API (Paper Trading)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_ORDER_SYMBOL=SPY

# 3. Database
# Local docker-compose overrides DATABASE_URL to the `timescaledb` service.
# For direct (non-Docker) runs, point this at your TimescaleDB/Tiger Data URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@timescaledb:5432/floatlinedb

# 4. PID Controller Configuration
PID_SETPOINT=1500.00
PID_KP=0.5
PID_KI=0.1
PID_KD=0.05
PID_DEADBAND=50.00
SAVINGS_CAP=5000.00

# 5. Control loop (APScheduler runs inside FastAPI's lifespan; no Celery/Redis)
CONTROL_LOOP_ENABLED=true
POLL_INTERVAL=60
# "ledger" = track balances in Floatline's TimescaleDB shadow ledger (required
#            against the Nessie sandbox, which never mutates account balances)
# "live"   = read checking/savings from Nessie and equity from Alpaca each cycle
BALANCE_SOURCE=ledger